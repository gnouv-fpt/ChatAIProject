        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    subgraph Actors[\&quot;Actors\&quot;]\n        Citizen[\&quot;Student / Citizen\&quot;]\n        Admin[\&quot;Administrator\&quot;]\n    end\n\n    subgraph Platform[\&quot;Vietnam Traffic Law RAG Platform (Docker Compose)\&quot;]\n        GW[\&quot;API Gateway .NET 8\&quot;]\n\n        subgraph RESTAPI[\&quot;REST API Service .NET 8\&quot;]\n            A1[\&quot;Auth Module\&quot;]\n            A2[\&quot;Chat Module + gRPC Client\&quot;]\n            A3[\&quot;Legal Docs Module\&quot;]\n        end\n\n        subgraph AIService[\&quot;AI Inference Service Python + gRPC Server\&quot;]\n            B1[\&quot;Moderation Engine\&quot;]\n            B2[\&quot;Advanced RAG Engine\&quot;]\n        end\n\n        subgraph WorkerSvc[\&quot;Worker Service .NET 8\&quot;]\n            C1[\&quot;Crawler Cron Job\&quot;]\n            C2[\&quot;Verification Cron Job\&quot;]\n            C3[\&quot;Session Cleanup Cron\&quot;]\n        end\n\n        subgraph MsgBroker[\&quot;Message Broker\&quot;]\n            Kafka[(\&quot;Apache Kafka\&quot;)]\n            Redis[(\&quot;Redis Cache\&quot;)]\n        end\n\n        subgraph Storage[\&quot;Data Storage\&quot;]\n            SQL[(\&quot;SQL Server 2022\&quot;)]\n            Qdrant[(\&quot;Qdrant Vector DB\&quot;)]\n        end\n\n        GW --&gt;|HTTP/REST| RESTAPI\n        GW -.-&gt;|Rate Limit Counter| Redis\n\n        A2 --&gt;|gRPC Request| AIService\n        AIService --&gt;|gRPC Response| A2\n\n        WorkerSvc --&gt;|Publish document-indexed-events| Kafka\n        Kafka --&gt;|Consume - Invalidate Cache| RESTAPI\n\n        RESTAPI --&gt;|CRUD| SQL\n        WorkerSvc --&gt;|CRUD| SQL\n\n        B2 --&gt;|Vector Search Verified Only| Qdrant\n        C1 --&gt;|Index New Law Embeddings| Qdrant\n        RESTAPI -.-&gt;|Cache-aside Response| Redis\n    end\n\n    subgraph External[\&quot;External\&quot;]\n        Law[\&quot;thuvienphapluat.vn\&quot;]\n    end\n\n    Citizen --&gt;|HTTPS| GW\n    Admin --&gt;|HTTPS| GW\n    C1 -.-&gt;|Crawl HTTP| Law\n\n    classDef actor fill:#E1F5FE,stroke:#0288D1,color:#01579B;\n    classDef gw fill:#FFF9C4,stroke:#FBC02D,color:#F57F17;\n    classDef svc fill:#E8F5E9,stroke:#2E7D32,color:#1B5E20;\n    classDef broker fill:#F3E5F5,stroke:#7B1FA2,color:#4A148C;\n    classDef db fill:#ECEFF1,stroke:#455A64,color:#263238;\n    classDef ext fill:#FFF3E0,stroke:#EF6C00,color:#E65100;\n\n    class Citizen,Admin actor;\n    class GW gw;\n    class A1,A2,A3,B1,B2,C1,C2,C3 svc;\n    class Kafka,Redis broker;\n    class SQL,Qdrant db;\n    class Law ext;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="TNR82QqKptwaEbBc07dE-14">
