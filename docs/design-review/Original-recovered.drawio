        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor U as User\n    participant API as REST API\n    participant DB as SQL Server\n    participant AI as gRPC AI\n    participant Q as Qdrant\n    participant LLM as External AI\n    participant R as Redis\n    participant W as Worker\n    participant SMTP as SMTP\n\n    U-&gt;&gt;API: Ask legal question\n    API-&gt;&gt;DB: Save question\n    API-&gt;&gt;AI: Process prompt\n\n    AI-&gt;&gt;AI: Moderation\n\n    alt Violation\n        AI--&gt;&gt;API: Violation alert\n    else Valid\n        AI-&gt;&gt;LLM: Create embedding\n        LLM--&gt;&gt;AI: Vector\n        AI-&gt;&gt;Q: Search verified chunks\n        Q--&gt;&gt;AI: Legal sources\n        AI-&gt;&gt;LLM: Generate answer\n        LLM--&gt;&gt;AI: Answer\n        AI--&gt;&gt;API: Answer + citations\n    end\n\n    API-&gt;&gt;DB: Save response\n    API--&gt;&gt;U: Answer\n\n    API-&gt;&gt;R: Publish event\n    R-&gt;&gt;W: Consume event\n    W-&gt;&gt;DB: Deduct quota\n\n    opt Violation\n        W-&gt;&gt;DB: Save violation log\n        W-&gt;&gt;SMTP: Send warning email\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="uINlerSBXH9cblhTy0bO-299">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
