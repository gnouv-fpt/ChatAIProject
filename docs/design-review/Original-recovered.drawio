        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    subgraph EVENTS[\&quot;Event Consumer\&quot;]\n        SUB[\&quot;Redis Subscriber\&quot;]:::broker\n        QUOTA[\&quot;Quota Deductor\&quot;]:::logic\n        ALERT[\&quot;Email Alert\&quot;]:::worker\n\n        SUB --&gt; QUOTA\n        SUB --&gt; ALERT\n    end\n\n    subgraph CRON[\&quot;Cron 00:00\&quot;]\n        SCHED[\&quot;Scheduler\&quot;]:::worker\n        CLEAN[\&quot;Clean Sessions\&quot;]:::logic\n        CHECK[\&quot;Check Expiry\&quot;]:::logic\n        REPORT[\&quot;Usage Report\&quot;]:::logic\n\n        SCHED --&gt; CLEAN\n        SCHED --&gt; CHECK\n        SCHED --&gt; REPORT\n    end\n\n    classDef logic fill:#f0fdfa,stroke:#2dd4bf,color:#1e293b;\n    classDef worker fill:#fff7ed,stroke:#fb923c,color:#1e293b;\n    classDef broker fill:#fdf4ff,stroke:#e879f9,color:#1e293b;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="uINlerSBXH9cblhTy0bO-354">
