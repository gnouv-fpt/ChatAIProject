        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USERS ||--o{ CHAT_SESSIONS : owns\n    USERS ||--o{ VIOLATION_LOGS : has\n    CHAT_SESSIONS ||--o{ CHAT_MESSAGES : contains\n    CHAT_MESSAGES ||--o{ CITATIONS : has\n    CHAT_MESSAGES ||--o| VIOLATION_LOGS : causes\n    LEGAL_DOCUMENTS ||--|{ DOCUMENT_CHUNKS : contains\n    DOCUMENT_CHUNKS ||--o{ CITATIONS : cited\n\n    USERS {\n        uuid Id PK\n        string Username UK\n        string Email UK\n        string Role\n        int TokenQuota\n        int TokenBalance\n    }\n\n    CHAT_SESSIONS {\n        uuid Id PK\n        uuid UserId FK\n        string Title\n        boolean IsDeleted\n    }\n\n    CHAT_MESSAGES {\n        uuid Id PK\n        uuid SessionId FK\n        string SenderRole\n        int TokensUsed\n        boolean IsViolation\n    }\n\n    CITATIONS {\n        uuid Id PK\n        uuid ChatMessageId FK\n        uuid DocumentChunkId FK\n        string SourceUrl\n    }\n\n    LEGAL_DOCUMENTS {\n        uuid Id PK\n        string DocumentNumber UK\n        string Title\n        date EffectiveDate\n        date ExpirationDate\n        boolean IsActive\n        string VerificationStatus\n    }\n\n    DOCUMENT_CHUNKS {\n        uuid Id PK\n        uuid DocumentId FK\n        string Article\n        string Clause\n        string VectorId\n        boolean IsVerified\n    }\n\n    VIOLATION_LOGS {\n        uuid Id PK\n        uuid UserId FK\n        uuid ChatMessageId FK\n        string ViolationKeywords\n        boolean NotifiedViaEmail\n    }\n\n    USAGE_REPORTS {\n        uuid Id PK\n        date ReportDate UK\n        int TotalQueries\n        int TotalTokensUsed\n        int TotalViolations\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="uINlerSBXH9cblhTy0bO-71">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
