        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    subgraph PRESENTATION[\&quot;Presentation\&quot;]\n        AUTH[\&quot;Auth Controller\&quot;]:::api\n        CHAT[\&quot;Chat Controller\&quot;]:::api\n        DOC[\&quot;Document Controller\&quot;]:::api\n        REPORT[\&quot;Report Controller\&quot;]:::api\n    end\n\n    subgraph BUSINESS[\&quot;Business Logic\&quot;]\n        AUTHS[\&quot;Auth Service\&quot;]:::logic\n        CHATS[\&quot;Chatbot Service\&quot;]:::logic\n        DOCS[\&quot;Document Service\&quot;]:::logic\n        CRAWL[\&quot;Crawler Service\&quot;]:::logic\n        GRPC[\&quot;gRPC Client\&quot;]:::ai\n        PUB[\&quot;Redis Publisher\&quot;]:::broker\n    end\n\n    subgraph DATA[\&quot;Data Access\&quot;]\n        UREP[\&quot;User Repository\&quot;]:::data\n        SREP[\&quot;Session Repository\&quot;]:::data\n        MREP[\&quot;Message Repository\&quot;]:::data\n        DREP[\&quot;Document Repository\&quot;]:::data\n        CTX[(\&quot;DbContext\&quot;)]:::data\n    end\n\n    AUTH --&gt; AUTHS\n    CHAT --&gt; CHATS\n    DOC --&gt; DOCS\n    DOC --&gt; CRAWL\n    REPORT --&gt; DOCS\n\n    AUTHS --&gt; UREP\n    CHATS --&gt; SREP\n    CHATS --&gt; MREP\n    CHATS --&gt; GRPC\n    CHATS --&gt; PUB\n    DOCS --&gt; DREP\n\n    UREP --&gt; CTX\n    SREP --&gt; CTX\n    MREP --&gt; CTX\n    DREP --&gt; CTX\n\n    classDef api fill:#eef2ff,stroke:#818cf8,color:#1e293b;\n    classDef logic fill:#f0fdfa,stroke:#2dd4bf,color:#1e293b;\n    classDef ai fill:#f5f3ff,stroke:#a78bfa,color:#1e293b;\n    classDef broker fill:#fdf4ff,stroke:#e879f9,color:#1e293b;\n    classDef data fill:#ecfeff,stroke:#22d3ee,color:#1e293b;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Bw-i9z3rdxC5bYP4nsjL-109">
