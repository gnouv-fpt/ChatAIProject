        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n---\nflowchart TB\n    U([\&quot;User\&quot;]):::actor\n    A([\&quot;Admin\&quot;]):::actor\n    WEB[\&quot;Web / Mobile\&quot;]:::client\n\n    subgraph SYS[\&quot;Vietnam Traffic Law System\&quot;]\n        API[\&quot;REST API\&quot;]:::api\n        AI[\&quot;gRPC AI\&quot;]:::ai\n        REDIS[(\&quot;Redis\&quot;)]:::broker\n        WORKER[\&quot;Worker\&quot;]:::worker\n        SQL[(\&quot;SQL Server\&quot;)]:::data\n        QDRANT[(\&quot;Qdrant\&quot;)]:::data\n    end\n\n    TVPL[\&quot;Thư viện pháp luật\&quot;]:::external\n    LLM[\&quot;LLM Provider\&quot;]:::external\n    SMTP[\&quot;SMTP Server\&quot;]:::external\n\n    U --&gt; WEB\n    A --&gt; WEB\n    WEB --&gt; API\n\n    API --&gt; SQL\n    API --&gt; AI\n    API --&gt; REDIS\n    API --&gt; TVPL\n\n    AI --&gt; QDRANT\n    AI --&gt; LLM\n\n    REDIS --&gt; WORKER\n    WORKER --&gt; SQL\n    WORKER --&gt; SMTP\n\n    classDef actor fill:#eef2ff,stroke:#818cf8,color:#1e293b;\n    classDef client fill:#f0fdfa,stroke:#2dd4bf,color:#1e293b;\n    classDef api fill:#eef2ff,stroke:#818cf8,color:#1e293b;\n    classDef ai fill:#f5f3ff,stroke:#a78bfa,color:#1e293b;\n    classDef worker fill:#fff7ed,stroke:#fb923c,color:#1e293b;\n    classDef broker fill:#fdf4ff,stroke:#e879f9,color:#1e293b;\n    classDef data fill:#ecfeff,stroke:#22d3ee,color:#1e293b;\n    classDef external fill:#f8fafc,stroke:#64748b,stroke-dasharray:4 4,color:#334155;\n    style SYS fill:#fffbeb,stroke:#f59e0b,stroke-width:2px;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="uINlerSBXH9cblhTy0bO-378">
