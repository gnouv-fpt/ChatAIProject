{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "readiness": {
        "ClusterId": "user",
        "Match": {
          "Path": "/health/ready"
        }
      },
      "content-readiness": {
        "ClusterId": "content",
        "Match": {
          "Path": "/health/content/ready"
        },
        "Transforms": [
          {
            "PathSet": "/health/ready"
          }
        ]
      },
      "content-documents": {
        "ClusterId": "content",
        "Order": -10,
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/api/documents/{**rest}"
        }
      },
      "content-question-banks": {
        "ClusterId": "content",
        "Order": -10,
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/api/question-banks/{**rest}"
        }
      },
      "content-questions": {
        "ClusterId": "content",
        "Order": -10,
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/api/questions/{**rest}"
        }
      },
      "content-exam-templates": {
        "ClusterId": "content",
        "Order": -10,
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/api/exam-templates/{**rest}"
        }
      },
      "content-crawl-jobs": {
        "ClusterId": "content",
        "Order": -10,
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/api/crawl-jobs/{**rest}"
        }
      },
      "content-document-index": {
        "ClusterId": "content",
        "Order": -10,
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/api/document-index/{**rest}"
        }
      },
      "content-admin": {
        "ClusterId": "content",
        "Order": -10,
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/api/admin/question-banks/{**rest}"
        }
      },
      "api": {
        "ClusterId": "user",
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/api/{**rest}"
        }
      },
      "web": {
        "ClusterId": "web",
        "Match": {
          "Path": "/{**rest}"
        },
        "Order": 100
      }
    },
    "Clusters": {
      "user": {
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "Destinations": {
          "user": {
            "Address": "http://localhost:5039/"
          }
        }
      },
      "content": {
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "Destinations": {
          "content": {
            "Address": "http://localhost:5040/"
          }
        }
      },
      "web": {
        "Destinations": {
          "web": {
            "Address": "http://localhost:5173/"
          }
        }
      }
    }
  }
}
