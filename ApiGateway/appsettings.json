{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "ReverseProxy": {
    "Routes": {
      "readiness": { "ClusterId": "rest", "Match": { "Path": "/health/ready" } },
      "api": { "ClusterId": "rest", "RateLimiterPolicy": "public", "Match": { "Path": "/api/{**rest}" } },
      "web": { "ClusterId": "web", "Match": { "Path": "/{**rest}" }, "Order": 100 }
    },
    "Clusters": {
      "rest": { "HttpRequest": { "ActivityTimeout": "00:02:00" }, "Destinations": { "rest": { "Address": "http://localhost:5039/" } } },
      "web": { "Destinations": { "web": { "Address": "http://localhost:5173/" } } }
    }
  }
}
