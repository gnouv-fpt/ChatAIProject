{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build-public.mjs",
  "installCommand": null,
  "outputDirectory": "public",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/review.html",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/learn.html",
      "destination": "/index.html",
      "permanent": false
    }
  ]
}
