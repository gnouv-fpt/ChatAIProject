@page "/Dashboard/Index"
@model Presentation.Pages.Dashboard.IndexModel

@{
    ViewData["Title"] = "Bảng điều khiển";
}

<div class="dashboard-page">
    <header class="dashboard-header">
        <div>
            <p class="dashboard-eyebrow">Bảng điều khiển</p>
            <h1 class="page-title">Chào mừng trở lại, @Model.ViewModel.UserName</h1>
            <p class="page-subtitle">Tiếp tục học từ môn học và tài liệu của bạn.</p>
        </div>
        <a asp-page="/Dashboard/SelectSubject" class="btn btn-primary dashboard-primary-action">
            <span class="material-symbols-outlined" aria-hidden="true">chat_bubble_outline</span>
            Bắt đầu hỏi trợ lý
        </a>
    </header>

    <section aria-label="Tổng quan học tập" class="dashboard-stats">
        <div class="dashboard-stat surface-card">
            <span class="material-symbols-outlined" aria-hidden="true">library_books</span>
            <div><span>Số môn học</span><strong>@Model.ViewModel.SubjectCount</strong></div>
        </div>
        <div class="dashboard-stat surface-card">
            <span class="material-symbols-outlined" aria-hidden="true">forum</span>
            <div><span>Số phiên chat</span><strong>@Model.ViewModel.ChatSessionCount</strong></div>
        </div>
        <div class="dashboard-stat surface-card">
            <span class="material-symbols-outlined" aria-hidden="true">description</span>
            <div><span>Tài liệu đã xử lý</span><strong>@Model.ViewModel.IndexedDocumentCount</strong></div>
        </div>
    </section>

    <section class="dashboard-courses" aria-labelledby="recent-courses-title">
        <div class="dashboard-section-heading">
            <h2 id="recent-courses-title">Môn học gần đây</h2>
            <a asp-page="/Dashboard/SelectSubject">Xem tất cả</a>
        </div>

        @if (!Model.ViewModel.RecentCourses.Any())
        {
            <div class="surface-card padded dashboard-empty">
                <span class="material-symbols-outlined" aria-hidden="true">school</span>
                <p>Bạn chưa có môn học nào. Hãy liên hệ giảng viên để được thêm vào môn học.</p>
            </div>
        }
        else
        {
            <div class="dashboard-course-grid">
                @foreach (var course in Model.ViewModel.RecentCourses)
                {
                    <a asp-page="/Chat/Index" asp-route-subjectId="@course.Id" class="surface-card dashboard-course-card">
                        <div class="dashboard-course-top">
                            <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
                            <span class="dashboard-course-code">@course.SubjectCode</span>
                        </div>
                        <h3>@course.SubjectName</h3>
                        <p>@(string.IsNullOrWhiteSpace(course.Description) ? $"{course.IndexedDocumentCount} tài liệu đã xử lý" : course.Description)</p>
                        <div class="dashboard-course-progress-label">
                            <span>Tiến độ</span><strong>@course.ProgressPercent%</strong>
                        </div>
                        <div class="dashboard-course-progress" role="progressbar" aria-label="Tiến độ môn @course.SubjectName" aria-valuenow="@course.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                            <span style="width:@course.ProgressPercent%"></span>
                        </div>
                        <span class="dashboard-course-link">Mở trò chuyện <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></span>
                    </a>
                }
            </div>
        }
    </section>
</div>
