{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "UserConnection": "Server=localhost;Database=TrafficUserDb;Trusted_Connection=True;TrustServerCertificate=true;Encrypt=false;",
    "ContentConnection": "Server=localhost;Database=TrafficContentDb;Trusted_Connection=True;TrustServerCertificate=true;Encrypt=false;"
