# Copy to .env (ignored by Git), fill unique random values. Never commit .env.
SA_PASSWORD=
JWT_SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
GRAFANA_PASSWORD=
GOOGLE_API_KEY=
GROQ_API_KEY=
GATEWAY_PORT=8080
GRAFANA_PORT=3000
# Enable only on a new disposable database or after reviewing migrations/backing up old data.
MIGRATE_ON_STARTUP=false
# After applying User schema, opt in to configured admin seeding for the User host.
SEED_ADMIN_ON_STARTUP=false
# Set to Khanh's actual Worker build, then use --profile worker.
WORKER_IMAGE=traffic-rag-worker:handoff
# Compose uses TrafficUserDb and TrafficContentDb separately on sqlserver.
# Local runs: set ConnectionStrings__UserConnection / ConnectionStrings__ContentConnection.
# Service__Module=User (5039) or Content (5040); see docs/C2-SCHEMA-CONTRACT.md.
# Redis is required for custom exams; Kafka topics are notifications only.
