# Local Ollama setup (recommended for this project; no cloud API key required)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Text/RAG model
OLLAMA_MODEL=qwen2.5:latest

# Image chat model. It is loaded only when an image has no readable text.
VISION_PROVIDER=ollama
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Optional server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=*

# Optional cloud providers. Leave empty when using Ollama.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Ollama context window (tokens). Prompts longer than this are silently truncated.
OLLAMA_NUM_CTX=8192
