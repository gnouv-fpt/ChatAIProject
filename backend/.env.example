# ==============================================================================
# FastAPI RAG Backend Configuration (FLM Assistant)
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Configuration (Comma-separated list or * for all)
CORS_ORIGINS=*

# Knowledge Vault & Data Paths (Relative to repository root or absolute)
KNOWLEDGE_VAULT_DIR=flm_knowledge_vault
COURSES_DATA_PATH=flm_flutter_data/courses_data.json

# LLM Provider Configuration
# Supported options: auto, gemini, openai, groq, ollama, local
# 'auto' will use the first available provider with configured API key, 
# or fallback smoothly to high-precision local semantic generator.
LLM_PROVIDER=auto

# Google Gemini API Settings (Recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Settings
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Groq API Settings
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Local Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Retrieval & RAG Parameters
TOP_K_CHUNKS=4
SIMILARITY_THRESHOLD=0.15
ENABLE_EXACT_CODE_BOOST=true
