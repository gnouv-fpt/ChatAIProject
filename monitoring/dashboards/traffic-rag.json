{
  "uid": "traffic-rag",
  "title": "Traffic RAG · Integration",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Service health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP latency p95 by service",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (job,le) (rate(http_server_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Completed chat usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(chat_tokens_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Exam events confirmed by Kafka",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(increase(exam_event_broker_confirmed_total[30m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Exam events processed / duplicate / retry / failed",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(exam_event_processed_total[5m]))",
          "legendFormat": "processed",
          "refId": "A"
        },
        {
          "expr": "sum by (job) (rate(exam_event_duplicate_total[5m]))",
          "legendFormat": "duplicate",
          "refId": "B"
        },
        {
          "expr": "sum by (job) (rate(exam_event_retry_total[5m]))",
          "legendFormat": "retry",
          "refId": "C"
        },
        {
          "expr": "sum by (job) (rate(exam_event_failed_total[5m]))",
          "legendFormat": "failed",
          "refId": "D"
        }
      ]
    },
    {
      "id": 8,
      "title": "Kafka consumer lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "kafka_consumergroup_lag",
          "refId": "A",
          "legendFormat": "{{consumergroup}} / {{topic}} / {{partition}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Application file logs (metadata only)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "expr": "{job=\"traffic-rag\"} | json",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "gRPC request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (method,status) (rate(grpc_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "gRPC latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by (method,le) (rate(grpc_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Kafka events received",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (topic) (rate(exam_event_received_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Kafka exporter available",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "up{job=\"kafka\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
